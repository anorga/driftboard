# ---- Client (Vite) ----
# Only needed when the client is hosted separately from the sync server
# (e.g. client on Vercel, sync server on Render). When the app is served by
# the sync server itself, the client connects same-origin and this can be
# left unset.
VITE_WS_URL=wss://your-sync-server.onrender.com

# ---- Sync server ----
# Where board snapshots are stored (default: ./data). Set empty to run purely
# in-memory (rooms then live until the process exits).
# DATA_DIR=./data

# Cap on concurrently loaded rooms (default: 1000).
# MAX_ROOMS=1000

# Comma-separated browser origins allowed to connect over WebSocket.
# Unset = allow all (needed for split deploys unless you list the client URL).
# ALLOWED_ORIGINS=https://your-app.vercel.app
